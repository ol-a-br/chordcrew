# Loaded by the Firebase CLI on deploy and in the emulator.
#
# App Check rollout (docs/deployment.md → "App Check"):
#   false = monitor phase — requests without an App Check token are still
#           served (invalid tokens are always rejected)
#   true  = enforce — only the ChordCrew web app may call the functions.
#           Switch on once the App Check metrics in the Firebase console show
#           (almost) all requests as verified, then `npm run deploy`.
ENFORCE_APP_CHECK=false
