# Copy this file to .env.local and fill in your Firebase project values.
# Get these from: Firebase Console → Project Settings → Your apps → Web app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — Firebase App Check (docs/deployment.md → "App Check").
# reCAPTCHA Enterprise *site key* (public, safe to ship in the bundle).
VITE_APPCHECK_SITE_KEY=
# Local dev only: a debug token registered under App Check → Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=
